<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenIPC.Viewer.ViewModels;assembly=OpenIPC.Viewer.App"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OpenIPC.Viewer.App.Views.Pages.GridPage"
             x:DataType="vm:GridViewModel">

    <!-- Fondo sólido oscuro para la TV Box -->
    <Grid Background="#101010">
        <!-- Grilla de distribución dinámica de las celdas de las cámaras -->
        <ItemsControl ItemsSource="{Binding VisibleCameras}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding GridColumns, FallbackValue=2}" 
                                 Rows="{Binding GridRows, FallbackValue=2}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
