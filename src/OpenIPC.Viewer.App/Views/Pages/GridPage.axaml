<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:controls="using:OpenIPC.Viewer.App.Controls"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:input="using:Avalonia.Input"
             x:Class="OpenIPC.Viewer.App.Views.Pages.GridPage"
             x:DataType="vm:GridPageViewModel"
             RenderOptions.EdgeMode="Aliased"
             RenderOptions.BitmapInterpolationMode="LowQuality"
             UseLayoutRounding="True">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header Principal (Solo 1 Fila Superior Compacta) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      
      <!-- LADO IZQUIERDO: Título "Live" + Pestaña "Default" en la misma línea -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   FontSize="{StaticResource FontSizeXl}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />

        <!-- Botón / Pestañas de Layout alineadas al lado de "Live" -->
        <ItemsControl ItemsSource="{Binding Layouts}" x:CompileBindings="False" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Tapped="OnTabTapped"
                      PointerPressed="OnTabPointerPressed"
                      PointerMoved="OnTabPointerMoved"
                      AttachedToVisualTree="OnTabAttached"
                      input:DragDrop.AllowDrop="True"
                      Cursor="Hand"
                      Padding="10,5" CornerRadius="6"
                      BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                <Border.Background>
                  <MultiBinding Converter="{x:Static conv:LayoutTabBrushConverter.Instance}">
                    <Binding />
                    <Binding Path="DataContext.ActiveLayout" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                  </MultiBinding>
                </Border.Background>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- LADO DERECHO: Botones de herramientas -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        
        <!-- Botón selector de Grid -->
        <Button Padding="10,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                Foreground="{StaticResource TextPrimaryBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="lucide" Data="{StaticResource IconLayoutGrid}"
                  Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
            <TextBlock Text="Grid" VerticalAlignment="Center" FontSize="13" />
          </StackPanel>

          <Button.Flyout>
            <Flyout Placement="Bottom">
              <Border Padding="4" Background="{StaticResource Bg1Brush}" CornerRadius="6">
                <StackPanel Orientation="Vertical" Spacing="2">
                  <Button Content="1 × 1" Command="{Binding SetLayoutCommand}" CommandParameter="1"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                  <Button Content="2 × 2" Command="{Binding SetLayoutCommand}" CommandParameter="2"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                  <Button Content="3 × 3" Command="{Binding SetLayoutCommand}" CommandParameter="3"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                  <Button Content="4 × 4" Command="{Binding SetLayoutCommand}" CommandParameter="4"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                  <Button Content="5 × 5" Command="{Binding SetLayoutCommand}" CommandParameter="5"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <!-- Fullscreen -->
        <Button Click="OnFullscreenClick"
                Margin="4,0,4,0" Padding="10,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                ToolTip.Tip="{Binding [Grid.Tooltip.Fullscreen], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconMaximize}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>

        <!-- Separador visual -->
        <Border Width="1" Height="20" Background="{StaticResource BorderWeakBrush}" Margin="4,0" VerticalAlignment="Center" />

        <!-- Gestión de Layouts ( +, Monitor, Lápiz ) -->
        <Button Command="{Binding AddLayoutCommand}"
                Content="+" FontSize="16" FontWeight="SemiBold"
                Padding="12,2" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                Foreground="{StaticResource TextPrimaryBrush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                ToolTip.Tip="{Binding [Layouts.Tooltip.Add], Source={x:Static svc:Localizer.Instance}}" />
        <Button Command="{Binding ManageCamerasCommand}"
                Padding="10,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                ToolTip.Tip="{Binding [Layouts.Tooltip.Cameras], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconVideo}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>
        <Button Command="{Binding RenameLayoutCommand}"
                Padding="10,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                ToolTip.Tip="{Binding [Layouts.Tooltip.Rename], Source={x:Static svc:Localizer.Instance}}">
          <Path Classes="lucide" Data="{StaticResource IconEdit}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>

      </StackPanel>
    </Grid>

    <!-- Grid de Cámaras (Estirado al máximo vertical) -->
    <ItemsControl Grid.Row="1" 
                  ItemsSource="{Binding Slots}" 
                  x:CompileBindings="False"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  RenderOptions.EdgeMode="Aliased"
                  RenderOptions.BitmapInterpolationMode="LowQuality"
                  UseLayoutRounding="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="4"
                  Background="{StaticResource Bg0Brush}"
                  CornerRadius="6"
                  ClipToBounds="True"
                  input:DragDrop.AllowDrop="True"
                  AttachedToVisualTree="OnSlotAttached">
            <Grid>
              <!-- Empty placeholder estilo NVR con Logo PNG -->
              <Border IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNull}}"
                      Background="#111111">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <Image Source="avares://OpenIPC.Viewer.App/Assets/logo_placeholder.png"
                         MaxWidth="160"
                         MaxHeight="160"
                         Opacity="0.3"
                         Stretch="Uniform" />
                  <TextBlock Text="{Binding [Grid.EmptySlot], Source={x:Static svc:Localizer.Instance}}"
                             HorizontalAlignment="Center"
                             Foreground="#555555"
                             FontSize="12" />
                </StackPanel>
              </Border>

              <!-- Tile -->
              <ContentControl Content="{Binding}"
                              IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="vm:CameraTileViewModel">
                    <Grid Cursor="Hand"
                          Background="Transparent"
                          Tapped="OnTileTapped"
                          PointerPressed="OnTilePointerPressed"
                          PointerMoved="OnTilePointerMoved">
                      <controls:RtspVideoView Session="{Binding Session}"
                                              IsVisible="{Binding !StillsMode}" />

                      <!-- Stills mode -->
                      <Image Source="{Binding StillFrame}"
                             Stretch="Uniform"
                             IsVisible="{Binding StillsMode}" />

                      <!-- AI detection boxes -->
                      <controls:DetectionOverlay Detections="{Binding Detections}"
                                                 ShowBoxes="{Binding AnalyticsEnabled}"
                                                 SourceAspect="{Binding SourceAspect}"
                                                 IsHitTestVisible="False" />

                      <!-- Bottom-left: Audio Toggle + Camera Name -->
                      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                                  Orientation="Horizontal" Spacing="6" Margin="8">
                        <Button Command="{Binding ToggleListenCommand}"
                                IsVisible="{Binding AudioAvailable}"
                                Background="#80000000" CornerRadius="14"
                                Width="28" Height="28" Padding="0"
                                ToolTip.Tip="{Binding [CameraPage.Tooltip.Listen], Source={x:Static svc:Localizer.Instance}}">
                          <Panel>
                            <Path Classes="lucide" Data="{StaticResource IconVolume}"
                                  Stroke="{StaticResource AccentBrush}" Width="16" Height="16"
                                  IsVisible="{Binding IsListening}" />
                            <Path Classes="lucide" Data="{StaticResource IconVolumeMuted}"
                                  Stroke="White" Width="16" Height="16"
                                  IsVisible="{Binding !IsListening}" />
                          </Panel>
                        </Button>

                        <Border Background="#90000000" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="Medium" />
                        </Border>
                      </StackPanel>

                      <!-- Bottom-center: object counter -->
                      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8"
                              Background="#90000000" CornerRadius="3" Padding="6,2"
                              IsVisible="{Binding HasDetections}">
                        <TextBlock Text="{Binding DetectionCounter}" Foreground="White" FontSize="11" FontWeight="Medium" />
                      </Border>

                      <!-- Bottom-right: state badge (LIVE) -->
                      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                              CornerRadius="3" Padding="6,2"
                              Background="{Binding Status, Converter={x:Static conv:CameraStatusColorConverter.Instance}}">
                        <TextBlock Text="{Binding StateLabel}" Foreground="White"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" />
                      </Border>

                      <Border IsVisible="{Binding SnapshotFlash}" Background="#50FFFFFF"
                              IsHitTestVisible="False" />

                      <Border IsVisible="{Binding IsConnecting}" Background="#80000000">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                          <ProgressBar IsIndeterminate="True" Width="110" />
                          <TextBlock Text="{Binding ConnectingLabel}"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="{StaticResource FontSizeSm}"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <Border IsVisible="{Binding IsFailed}" Background="#A4000000">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" Margin="12" MaxWidth="320">
                          <Path Classes="lucide" Data="{StaticResource IconPlugOff}"
                                Stroke="{StaticResource DangerBrush}" Width="26" Height="26"
                                HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding [Stream.Disconnected], Source={x:Static svc:Localizer.Instance}}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     FontWeight="Medium"
                                     HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding ErrorDetail}"
                                     Foreground="{StaticResource TextTertiaryBrush}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" Spacing="8"
                                      HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="{Binding [Common.Retry], Source={x:Static svc:Localizer.Instance}}"
                                    Command="{Binding RetryCommand}"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    CornerRadius="6" Padding="13,6" FontSize="12" />
                            <Button Content="{Binding [Common.Close], Source={x:Static svc:Localizer.Instance}}"
                                    Command="{Binding CloseCommand}"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    CornerRadius="6" Padding="13,6" FontSize="12" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Pager -->
    <Border Grid.Row="2"
            IsVisible="{Binding HasMultiplePages}"
            HorizontalAlignment="Center"
            Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding PrevPageCommand}"
                IsEnabled="{Binding CanPrevPage}"
                Padding="8,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
          <Path Classes="lucide" Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>

        <ItemsControl ItemsSource="{Binding Pages}" x:CompileBindings="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}"
                      Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      MinWidth="32" Padding="8,6" CornerRadius="6"
                      HorizontalContentAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
                <Button.Background>
                  <MultiBinding Converter="{x:Static conv:PageActiveBrushConverter.Instance}">
                    <Binding />
                    <Binding Path="DataContext.CurrentPageDisplay" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                  </MultiBinding>
                </Button.Background>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanNextPage}"
                Padding="8,6" CornerRadius="6"
                Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
          <Path Classes="lucide" Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextPrimaryBrush}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
