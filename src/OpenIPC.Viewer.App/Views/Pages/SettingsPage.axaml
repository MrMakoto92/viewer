<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenIPC.Viewer.App.ViewModels"
             xmlns:svc="using:OpenIPC.Viewer.App.Services"
             xmlns:conv="using:OpenIPC.Viewer.App.Converters"
             x:Class="OpenIPC.Viewer.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

  <UserControl.Styles>
    <!-- Estilos de sección -->
    <Style Selector="Path.section-icon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!-- Botones adaptados para D-Pad -->
    <Style Selector="Button.tv-focusable">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Button.tv-focusable:focus">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>

    <!-- CheckBox adaptados para D-Pad -->
    <Style Selector="CheckBox.tv-focusable">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="CheckBox.tv-focusable:focus">
      <Setter Property="Background" Value="{StaticResource BorderWeakBrush}" />
    </Style>

    <!-- ComboBox adaptados para D-Pad -->
    <Style Selector="ComboBox.tv-focusable">
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="ComboBox.tv-focusable:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <!-- Se mantiene x:Name="RootGrid" para que no rompa el code-behind C# -->
  <Grid x:Name="RootGrid">
    <ScrollViewer Padding="16,16,16,32" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">

        <!-- Título Principal -->
        <TextBlock Text="{Binding [Settings.Title], Source={x:Static svc:Localizer.Instance}}"
                   FontSize="{StaticResource FontSizeXl}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />

        <!-- SECCIÓN 1: APARIENCIA / GENERAL -->
        <Border Background="{StaticResource Bg2Brush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="lucide section-icon" Data="{StaticResource IconAppearance}" />
              <TextBlock Classes="section-title"
                         Text="{Binding [Settings.Appearance], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>

            <!-- Idioma -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="field-label"
                         Text="{Binding [Settings.Appearance.Language], Source={x:Static svc:Localizer.Instance}}" />
              <ComboBox Grid.Column="1" Classes="tv-focusable"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding Language, Mode=TwoWay}"
                        MinWidth="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding ., Converter={x:Static conv:LanguageCodeConverter.Instance}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- Splash Screen -->
            <CheckBox Classes="tv-focusable"
                      IsChecked="{Binding ShowSplash}"
                      Content="{Binding [Settings.Appearance.ShowSplash], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>

        <!-- SECCIÓN 2: VIDEO Y RENDIMIENTO -->
        <Border Background="{StaticResource Bg2Brush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="lucide section-icon" Data="{StaticResource IconVideo}" />
              <TextBlock Classes="section-title"
                         Text="{Binding [Settings.Video], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>

            <!-- Cambio automático de calidad SD/HD -->
            <CheckBox Classes="tv-focusable"
                      IsChecked="{Binding AutoSdHd}"
                      Content="{Binding [Settings.Video.AutoSdHd], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Forzar CPU / Aceleración Hardware -->
            <CheckBox Classes="tv-focusable"
                      IsChecked="{Binding AiForceCpu}"
                      Content="{Binding [Settings.Video.AiForceCpu], Source={x:Static svc:Localizer.Instance}}"
                      Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Protocolo RTSP (UDP/TCP) -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="field-label"
                         Text="{Binding [Settings.Video.RtspTransport], Source={x:Static svc:Localizer.Instance}}" />
              <ComboBox Grid.Column="1" Classes="tv-focusable"
                        ItemsSource="{Binding TransportOptions}"
                        SelectedItem="{Binding RtspTransport, Mode=TwoWay}"
                        MinWidth="120" />
            </Grid>

            <!-- Máximo de transmisiones en cuadrícula -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="field-label"
                         Text="{Binding [Settings.Video.MaxGridSessions], Source={x:Static svc:Localizer.Instance}}" />
              <ComboBox Grid.Column="1" Classes="tv-focusable"
                        ItemsSource="{Binding GridSessionOptions}"
                        SelectedItem="{Binding MaxConcurrentGridSessions, Mode=TwoWay}"
                        MinWidth="120" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- SECCIÓN 3: ACERCA DE -->
        <Border Background="{StaticResource Bg2Brush}" CornerRadius="8" Padding="16">
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="lucide section-icon" Data="{StaticResource IconAbout}" />
              <TextBlock Classes="section-title"
                         Text="{Binding [Settings.About], Source={x:Static svc:Localizer.Instance}}" />
            </StackPanel>

            <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
              <Run Text="OrionViewer+ " />
              <Run Text="{Binding Version}" />
            </TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="tv-focusable"
                      Content="{Binding [Settings.About.Repository], Source={x:Static svc:Localizer.Instance}}"
                      Command="{Binding OpenRepositoryCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
